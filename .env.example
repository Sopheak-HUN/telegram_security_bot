# --- Required ---------------------------------------------------------------

# From @BotFather → /newbot (or /token).
BOT_TOKEN=paste-your-token-from-@BotFather-here

# Long random string (A-Z, a-z, 0-9, _, -). Telegram sends this back as the
# X-Telegram-Bot-Api-Secret-Token header on every webhook request.
WEBHOOK_SECRET=change-me-to-a-long-random-string

# Long random string. Required to call /api/setup?secret=...
SETUP_SECRET=change-me-to-another-long-random-string

# --- Storage (Upstash Redis via Vercel Marketplace) -------------------------
# Auto-provisioned when you connect Upstash Redis to the project in the
# Vercel dashboard. For local dev: `vercel env pull .env` after `vercel link`.
# The bot reads either UPSTASH_* or KV_* pair.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Flood warning (optional tuning) ----------------------------------------
# Warn a user who sends SPAM_LIMIT messages within SPAM_WINDOW_SECONDS.
# SPAM_LIMIT=5
# SPAM_WINDOW_SECONDS=10

# --- Weather on mention (optional) ------------------------------------------
# "@bot weather" replies with current conditions at the location the user last
# shared with the bot (📎 attach → Location). With a key below it uses the
# Google Weather API (enable "Weather API" in a Google Maps Platform project:
# https://console.cloud.google.com). Leave blank to use the keyless Open-Meteo
# fallback instead. (Apple WeatherKit is not supported — it needs an Apple
# Developer membership and signed JWTs.)
GOOGLE_WEATHER_API_KEY=

# --- AI spam classifier (optional) ------------------------------------------
# Get a free key at https://aistudio.google.com/apikey (no credit card).
# Leave blank to disable AI — the bot falls back to URL-whitelist only.
# Free tier: 1500 requests/day with Gemini 2.0 Flash. Verdicts are cached in
# Redis for 1 hour, so duplicate spam floods cost only one request.
GEMINI_API_KEY=
